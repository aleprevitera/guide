---
import BaseLayout from '../layouts/BaseLayout.astro';
import YearTiles from '../components/home/YearTiles.astro';
import LetteraMission from '../components/home/LetteraMission.astro';
---

<BaseLayout title="Home" description="Guide pratiche universitarie">
  <h1>Guide pratiche universitarie</h1>
  <p class="intro">
    Programmi, fonti di studio, tempistiche e consigli pratici per ogni esame, scritti dai
    rappresentanti degli studenti.
  </p>

  <section aria-labelledby="anni-titolo" id="anni">
    <h2 id="anni-titolo">Scegli il tuo anno</h2>
    <YearTiles />
  </section>

  <LetteraMission />

  <p class="tutte">
    <a class="btn-px label" href="/guide/">Tutte le guide</a>
  </p>
</BaseLayout>

<style>
  .intro {
    color: var(--text-2);
  }
  #anni {
    scroll-margin-top: 16px;
  }
  .tutte {
    margin: 32px var(--px) 0;
  }
</style>

<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script is:inline>
  // Gli inviti/recuperi password di Netlify Identity atterrano sulla home
  // del sito (SITE_URL/#invite_token=...): questo gestore apre il popup di
  // attivazione e, dopo il login, porta l'utente su /admin/.
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on('init', (user) => {
      if (!user) {
        window.netlifyIdentity.on('login', () => {
          document.location.href = '/admin/';
        });
      }
    });
  }
</script>
