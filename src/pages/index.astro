---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelIcon from '../components/common/PixelIcon.astro';
---

<BaseLayout title="Home" description="Guide pratiche universitarie">
  <section class="hero panel px-border" aria-labelledby="hero-title">
    <PixelIcon name="book" size={32} />
    <h1 id="hero-title">Guide pratiche universitarie</h1>
    <p>
      Guide compilate e mantenute dai rappresentanti degli studenti per aiutarti a prepararti
      agli esami: programmi, fonti di studio, tempistiche e consigli pratici.
    </p>
    <p class="hero__cta">
      <a class="btn-px btn-px--accent label" href="/guide/">Vai alle guide</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-top: 16px;
  }
  .hero h1 {
    margin-top: 16px;
  }
  .hero p {
    color: var(--text-2);
  }
  .hero__cta {
    margin: 24px 0 0;
  }
</style>

<script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script is:inline>
  // Gli inviti/recuperi password di Netlify Identity atterrano sulla home
  // del sito (SITE_URL/#invite_token=...): questo gestore apre il popup di
  // attivazione e, dopo il login, porta l'utente su /admin/.
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on('init', (user) => {
      if (!user) {
        window.netlifyIdentity.on('login', () => {
          document.location.href = '/admin/';
        });
      }
    });
  }
</script>
