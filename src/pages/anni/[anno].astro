---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideList from '../../components/guide/GuideList.astro';
import PixelIcon from '../../components/common/PixelIcon.astro';
import { ANNI_DI_CORSO, annoSlug, numeroRomano, vtMondo, type Anno } from '../../lib/anni';
import { MONDI, stileMondo } from '../../lib/mondi';

export async function getStaticPaths() {
  const guide = await getCollection('guide');
  return ANNI_DI_CORSO.map((anno) => ({
    params: { anno: annoSlug(anno) },
    props: { anno, entries: guide.filter((g) => g.data.anno_di_corso === anno) },
  }));
}

interface Props {
  anno: Anno;
  entries: Awaited<ReturnType<typeof getCollection<'guide'>>>;
}

const { anno, entries } = Astro.props;
const mondo = MONDI[anno];
const numero = numeroRomano(anno);
---

<BaseLayout title={anno} description={`Guide pratiche agli esami del ${anno}`}>
  <p class="indietro"><a class="label" href="/#anni">&lt; Tutti gli anni</a></p>
  <header class="banner" style={`${stileMondo(anno)};view-transition-name:${vtMondo(anno)}`}>
    <div class="banner__cielo">
      <span class="banner__numero" aria-hidden="true">{numero}</span>
      <div>
        <h1>{anno}</h1>
        <p class="banner__conteggio label">
          {entries.length === 0 ? 'Nessuna guida' : `${entries.length} ${entries.length === 1 ? 'guida' : 'guide'}`}
        </p>
      </div>
      <PixelIcon name={mondo.icona} size={32} class="banner__icona" />
    </div>
    <span class="terreno" data-terreno={mondo.icona} aria-hidden="true"></span>
  </header>

  <div style={stileMondo(anno)}>
  {entries.length > 0 ? (
    <GuideList entries={entries} />
  ) : (
    <p class="vuoto panel px-border px-border--off">
      Nessuna guida ancora per questo anno: i rappresentanti ci stanno lavorando.
    </p>
  )}
  </div>
</BaseLayout>

<style>
  .indietro {
    margin: 0 0 8px;
  }
  .indietro a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .banner {
    margin: 4px 4px 24px;
    color: var(--mondo-ink);
    box-shadow: -4px 0 0 0 var(--text), 4px 0 0 0 var(--text), 0 -4px 0 0 var(--text), 0 4px 0 0 var(--text);
  }
  .banner__cielo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 48px 16px 16px;
    background: var(--mondo);
  }
  .banner h1 {
    margin: 0;
  }
  .banner__numero {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: 68px;
    line-height: 1;
    -webkit-font-smoothing: none;
  }
  .banner__conteggio {
    margin: 0;
  }
  .banner__cielo :global(.banner__icona) {
    position: absolute;
    right: 12px;
    top: 12px;
    animation: banner-salta 1s steps(1, end) infinite;
  }
  /* Desktop più sobrio: l'icona saltella qualche volta e si ferma. */
  @media (hover: hover) and (pointer: fine) {
    .banner__cielo :global(.banner__icona) {
      animation-iteration-count: 3;
    }
  }
  @keyframes banner-salta {
    0% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  @media (forced-colors: active) {
    .banner { outline: 2px solid CanvasText; }
  }
  .vuoto {
    color: var(--text-2);
    background: var(--bg);
  }
</style>
