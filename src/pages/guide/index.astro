---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePerSemestre from '../../components/guide/GuidePerSemestre.astro';
import SearchBox from '../../components/common/SearchBox.astro';
import { ANNI_DI_CORSO, annoHref, annoSlug } from '../../lib/anni';

const guide = await getCollection('guide');

const gruppi = ANNI_DI_CORSO.map((anno) => ({
  anno,
  entries: guide.filter((entry) => entry.data.anno_di_corso === anno),
})).filter((gruppo) => gruppo.entries.length > 0);
---

<BaseLayout title="Tutte le guide" description="Elenco delle guide pratiche per esame">
  <h1>Tutte le guide</h1>
  <SearchBox />
  {gruppi.map((gruppo) => (
    <section class="anno" aria-labelledby={`anno-${annoSlug(gruppo.anno)}`}>
      <h2 class="anno__titolo label" id={`anno-${annoSlug(gruppo.anno)}`}>
        <a href={annoHref(gruppo.anno)}>{gruppo.anno}</a>
      </h2>
      <GuidePerSemestre entries={gruppo.entries} livello={3} />
    </section>
  ))}
</BaseLayout>

<style>
  .anno {
    margin-bottom: 32px;
  }
  .anno__titolo {
    margin: 0 0 8px;
  }
  .anno__titolo a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--caption);
  }
</style>
