---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import GuideHeader from '../components/guide/GuideHeader.astro';
import ModuloSection from '../components/guide/ModuloSection.astro';
import InfoDaVerificareCallout from '../components/guide/InfoDaVerificareCallout.astro';
import UltimoAggiornamento from '../components/guide/UltimoAggiornamento.astro';

interface Props {
  data: CollectionEntry<'guide'>['data'];
}

const { data } = Astro.props;
---

<BaseLayout title={data.title}>
  <article class="guide">
    <GuideHeader
      title={data.title}
      anno_di_corso={data.anno_di_corso}
      cfu_totali={data.cfu_totali}
      moduli={data.moduli}
      link_sbobine_generale={data.link_sbobine_generale}
      link_whatsapp_generale={data.link_whatsapp_generale}
      descrizione_generale={data.descrizione_generale}
    />

    {data.moduli.map((modulo) => (
      <ModuloSection modulo={modulo} />
    ))}

    <InfoDaVerificareCallout items={data.info_da_verificare} />

    <UltimoAggiornamento data={data.ultimo_aggiornamento} autore={data.aggiornato_da} />
  </article>
</BaseLayout>
