---
import '../styles/global.css';
import pixelifyWoff2 from '@fontsource/pixelify-sans/files/pixelify-sans-latin-700-normal.woff2?url';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
  description?: string;
  aggiornamento?: Date;
  autore?: string;
}

const { title, description, aggiornamento, autore } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1a1c2c" />
    <title>{title} · Guide Universitarie</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href={pixelifyWoff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer aggiornamento={aggiornamento} autore={autore} />
  </body>
</html>
