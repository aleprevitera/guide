---
import PixelIcon from './PixelIcon.astro';
import AccountButton from './AccountButton.astro';
---

<header class="site-header" style="view-transition-name: intestazione">
  <a class="site-header__logo" href="/">
    <PixelIcon name="book" size={32} class="site-header__book" />
    <span class="label">Guide Universitarie</span>
  </a>
  <nav class="site-header__nav" aria-label="Principale">
    <a class="label" href="/guide/">Tutte le guide</a>
    <AccountButton />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    max-width: 720px;
    margin: 0 auto;
    padding: 12px 16px;
  }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  /* Saltello a due fotogrammi: 0 / -4px, a scatti. */
  .site-header__logo :global(.site-header__book) {
    animation: book-hop 1s steps(1, end) infinite;
  }
  @keyframes book-hop {
    0% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
  }
</style>
