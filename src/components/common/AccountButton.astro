---
// Stato dell'accesso nell'header: "Accedi" oppure nome + "Esci".
// L'accesso è facoltativo e serve per i contenuti extra (feedback).
---

<div class="account" data-account>
  <button type="button" class="account__btn label" data-account-accedi hidden>Accedi</button>
  <span class="account__utente" data-account-utente hidden>
    <span class="account__nome label" data-account-nome></span>
    <button type="button" class="account__btn account__btn--off label" data-account-esci>Esci</button>
  </span>
  <p class="account__toast label" role="status" aria-live="polite" data-account-toast></p>
</div>

<script>
  import { accedi, esci, EVENTO_AUTH, nomeBreve, statoAuth, type StatoAuth } from '../../lib/auth';
  import { saltello } from '../../lib/fx';

  const root = document.querySelector<HTMLElement>('[data-account]');
  if (root) {
    const btnAccedi = root.querySelector<HTMLButtonElement>('[data-account-accedi]')!;
    const utente = root.querySelector<HTMLElement>('[data-account-utente]')!;
    const nome = root.querySelector<HTMLElement>('[data-account-nome]')!;
    const toast = root.querySelector<HTMLElement>('[data-account-toast]')!;
    let timerToast: ReturnType<typeof setTimeout> | undefined;

    const mostraToast = (msg: string) => {
      toast.textContent = msg;
      toast.classList.add('is-visibile');
      clearTimeout(timerToast);
      timerToast = setTimeout(() => {
        toast.classList.remove('is-visibile');
        toast.textContent = '';
      }, 2400);
    };

    const aggiorna = ({ session, appenaEntrato, errore }: StatoAuth) => {
      btnAccedi.hidden = !!session;
      utente.hidden = !session;
      nome.textContent = session ? nomeBreve(session) : '';
      if (appenaEntrato) {
        saltello(nome);
        mostraToast('Accesso effettuato');
      }
      if (errore) mostraToast(errore);
    };

    statoAuth().then(aggiorna);
    window.addEventListener(EVENTO_AUTH, (e) => aggiorna((e as CustomEvent<StatoAuth>).detail));

    btnAccedi.addEventListener('click', async () => {
      const { errore } = await accedi();
      if (errore) mostraToast(errore);
    });
    root.querySelector('[data-account-esci]')!.addEventListener('click', async () => {
      await esci();
      mostraToast('Sei uscito');
    });
  }
</script>

<style>
  .account {
    display: inline-flex;
    align-items: center;
  }
  .account__utente {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .account__utente[hidden],
  .account__btn[hidden] {
    display: none;
  }
  .account__nome {
    display: inline-block;
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--you);
  }
  .account__btn {
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
    transition: transform 80ms steps(1, end);
  }
  .account__btn:hover { transform: translateY(-2px); }
  .account__btn:active { transform: translateY(2px); }
  .account__btn--off {
    background: var(--bg);
    color: var(--text-2);
    box-shadow: inset 0 0 0 2px var(--border-off);
  }
  /* Toast in basso, sopra la safe area dei telefoni. */
  .account__toast {
    position: fixed;
    left: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    margin: 0;
    padding: 12px 16px;
    background: var(--bg);
    color: var(--you);
    transform: translateX(-50%);
    box-shadow: -4px 0 0 0 var(--you), 4px 0 0 0 var(--you), 0 -4px 0 0 var(--you), 0 4px 0 0 var(--you);
    visibility: hidden;
    white-space: nowrap;
  }
  .account__toast.is-visibile {
    visibility: visible;
    animation: toast-entra 240ms steps(3, end);
  }
  @keyframes toast-entra {
    from { transform: translate(-50%, 12px); }
  }
  @media (forced-colors: active) {
    .account__btn, .account__toast { outline: 2px solid CanvasText; }
  }
</style>
