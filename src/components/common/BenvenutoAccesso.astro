---
// Proposta di accesso a inizio sessione: compare una volta per sessione del
// browser (cookie di sessione), solo a chi non ha fatto l'accesso. Facoltativa: chiudendola si
// continua a usare il sito, senza i contenuti extra (feedback).
import PixelIcon from './PixelIcon.astro';
---

<dialog class="benvenuto" aria-labelledby="benvenuto-titolo" data-benvenuto>
  <div class="benvenuto__testa">
    <PixelIcon name="lock" size={32} class="benvenuto__icona" />
    <h2 id="benvenuto-titolo">Ciao!</h2>
  </div>
  <p>
    Accedi con il tuo account <strong>@universitadipavia.it</strong> per sbloccare i contenuti
    extra: quanto hanno studiato gli altri per ogni esame, e il tuo voto.
  </p>
  <p class="benvenuto__nota">Basta farlo una volta: l'accesso resta attivo su questo dispositivo.</p>
  <p class="benvenuto__errore label" role="alert" data-benvenuto-errore hidden></p>
  <div class="benvenuto__azioni">
    <button type="button" class="btn-px btn-px--accent label" data-benvenuto-accedi>Accedi con Google</button>
    <button type="button" class="btn-px label benvenuto__dopo" data-benvenuto-chiudi>Continua senza accesso</button>
  </div>
</dialog>

<script>
  import { accedi, statoAuth } from '../../lib/auth';

  // Cookie di sessione (senza scadenza): condiviso fra le schede e cancellato
  // alla chiusura del browser. Così la proposta compare una volta per
  // sessione, anche aprendo le guide in schede nuove.
  const COOKIE = 'guide_benvenuto=1';
  const giaVisto = () => document.cookie.split('; ').includes(COOKIE);
  const segnaVisto = () => {
    document.cookie = `${COOKIE}; path=/; SameSite=Lax`;
  };
  const dialog = document.querySelector<HTMLDialogElement>('[data-benvenuto]');

  if (dialog && typeof dialog.showModal === 'function') {
    const errore = dialog.querySelector<HTMLElement>('[data-benvenuto-errore]')!;

    statoAuth().then(({ session, errore: msg }) => {
      if (session) return;
      const giaMostrato = giaVisto();
      segnaVisto();
      // Dopo un accesso fallito la riproponiamo con il motivo.
      if (giaMostrato && !msg) return;
      if (msg) {
        errore.textContent = msg;
        errore.hidden = false;
      }
      dialog.showModal();
    });

    dialog.querySelector('[data-benvenuto-chiudi]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-benvenuto-accedi]')!.addEventListener('click', async () => {
      const { errore: msg } = await accedi();
      if (msg) {
        errore.textContent = msg;
        errore.hidden = false;
      }
    });
    // Clic sullo sfondo: chiude come "Continua senza accesso".
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .benvenuto {
    width: min(100% - 32px, 440px);
    max-width: none;
    margin: auto;
    padding: 24px 20px;
    border: 0;
    background: var(--panel);
    color: var(--text);
    box-shadow: -4px 0 0 0 var(--text), 4px 0 0 0 var(--text), 0 -4px 0 0 var(--text), 0 4px 0 0 var(--text);
  }
  .benvenuto[open] {
    animation: benvenuto-entra 240ms steps(3, end);
  }
  @keyframes benvenuto-entra {
    from { transform: translateY(16px); }
  }
  .benvenuto::backdrop {
    background: rgb(26 28 44 / 0.88);
  }
  .benvenuto__testa {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .benvenuto__testa h2 {
    margin: 0;
    color: var(--accent);
  }
  .benvenuto__icona {
    animation: lucchetto-scuoti 1.2s steps(1, end) infinite;
  }
  @media (hover: hover) and (pointer: fine) {
    .benvenuto__icona {
      animation-iteration-count: 2;
    }
  }
  @keyframes lucchetto-scuoti {
    0%, 70% { transform: translateX(0); }
    80% { transform: translateX(-4px); }
    90% { transform: translateX(4px); }
  }
  .benvenuto p {
    color: var(--text-2);
  }
  .benvenuto__nota {
    font-size: 14px;
    color: var(--caption) !important;
  }
  .benvenuto__errore {
    color: var(--warn) !important;
  }
  .benvenuto__azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
  .benvenuto__dopo {
    background: var(--bg);
    color: var(--text-2);
    box-shadow: inset 0 0 0 2px var(--border-off);
  }
  @media (forced-colors: active) {
    .benvenuto { outline: 4px solid CanvasText; }
  }
</style>
