---
// Icone pixel art: griglia 8×8 (WhatsApp 16×16), solo rettangoli, renderizzate a multipli
// interi (8 → 16/24/32px) con shape-rendering="crispEdges".
interface Props {
  name: 'book' | 'alert' | 'letter' | 'lock' | 'lock-open' | 'cellula' | 'cuore' | 'batterio' | 'lastra' | 'cervello' | 'tocco' | 'lente' | 'moneta' | 'penna' | 'fumetto' | 'clessidra' | 'moduli' | 'teschio' | 'calendario' | 'whatsapp';
  size?: 16 | 24 | 32;
  class?: string;
}

const { name, size = 32, class: className } = Astro.props;
---

