---
interface Props {
  aggiornamento?: Date;
  autore?: string;
}

const { aggiornamento, autore } = Astro.props;
const formatted = aggiornamento?.toLocaleDateString('it-IT', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<footer class="site-footer label">
  {formatted && (
    <p>
      Ultimo aggiornamento: <time datetime={aggiornamento!.toISOString().slice(0, 10)}>{formatted}</time>
      {autore && <> · {autore}</>}
    </p>
  )}
  <p class="site-footer__firma">RUSPI <span class="site-footer__x">x</span> AGP</p>
</footer>

<style>
  .site-footer {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 16px 32px;
    color: var(--caption);
    border-top: 4px solid var(--chip);
  }
  .site-footer p {
    margin: 0 0 8px;
  }
  /* La "x" resta minuscola nel footer tutto maiuscolo. */
  .site-footer__x {
    text-transform: none;
  }
  .site-footer p:last-child {
    margin-bottom: 0;
  }
</style>
