---
import { renderRestrictedMarkdown } from '../../lib/markdown';

interface Props {
  text?: string;
}

const { text } = Astro.props;
const html = text ? await renderRestrictedMarkdown(text) : '';
---

{html && <div class="safe-markdown" set:html={html} />}

<style>
  .safe-markdown :global(p) {
    margin: 0 0 12px;
  }
  .safe-markdown :global(p:last-child),
  .safe-markdown :global(ul:last-child),
  .safe-markdown :global(ol:last-child) {
    margin-bottom: 0;
  }
  .safe-markdown :global(ul),
  .safe-markdown :global(ol) {
    margin: 0 0 12px;
    padding-left: 24px;
  }
  .safe-markdown :global(ul) {
    list-style-type: square;
  }
  .safe-markdown :global(a) {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
</style>
