---
// Istogramma del tempo di studio votato dagli studenti.
//
// Due modalità:
//   - collegata (prop `moduloId`): conteggi e voto letti/scritti su Supabase
//     dal browser; per votare serve l'accesso con Google con l'account
//     istituzionale (@universitadipavia.it).
//   - statica (props `counts` + `totale`): solo UI, usata da /dev/istogramma.
import { FASCE_STUDIO, type FasciaStudio } from '../../lib/fasce';
import { blocchiPerFascia, conteggiVuoti, MIN_RISPOSTE, MS_PER_BLOCCO, ritardoTu, type Conteggi } from '../../lib/histogram';

interface Props {
  /** Id stabile del modulo: attiva la modalità collegata. */
  moduloId?: string;
  /** Modalità statica: numero di voti per ciascuna fascia. */
  counts?: Conteggi;
  /** Modalità statica: numero totale di risposte. */
  totale?: number;
  /** Fascia stimata dal rappresentante (modulo.fascia_studio). */
  fasciaRappresentante?: FasciaStudio;
  /** Modalità statica: fascia votata dall'utente corrente. */
  fasciaUtente?: FasciaStudio;
  /** Titolo della sezione (default: "Tempo di studio"). */
  titolo?: string;
}

const { moduloId, counts = conteggiVuoti(), totale = 0, fasciaRappresentante, fasciaUtente, titolo = 'Tempo di studio' } = Astro.props;

const live = !!moduloId;
const uid = `hist-${Math.random().toString(36).slice(2, 8)}`;
const sufficienti = !live && totale >= MIN_RISPOSTE;
const blocchi = blocchiPerFascia(counts);
const righe = FASCE_STUDIO.map((fascia, i) => ({ fascia, count: counts[fascia] ?? 0, blocchi: blocchi[i], i }));
---

<section
  class="hist panel px-border"
  aria-labelledby={`${uid}-titolo`}
  data-hist
  data-modulo={moduloId}
  data-live={live ? '' : undefined}
  style={`--tu-delay:${ritardoTu(blocchi)}ms;--ms-blocco:${MS_PER_BLOCCO}ms`}
>
  <h2 class="hist__titolo label" id={`${uid}-titolo`}>{titolo}</h2>
  <p class="hist__totale label" data-totale>
    {live ? 'Caricamento…' : `${totale} ${totale === 1 ? 'risposta' : 'risposte'}`}
  </p>

  <ol class="hist__righe" aria-label="Distribuzione delle risposte per fascia" hidden={!sufficienti} data-righe>
    {righe.map((r) => (
      <li class:list={['riga', { 'riga--tu': r.fascia === fasciaUtente }]} data-fascia={r.fascia}>
        <div class="riga__testa">
          <span class="riga__fascia label">{r.fascia}</span>
          {r.fascia === fasciaRappresentante && (
            <span class="tag tag--rappr label" title="Stima del rappresentante">
              Rappr.<span class="visually-hidden"> (stima del rappresentante)</span>
            </span>
          )}
          <span class="tag tag--tu label" hidden={r.fascia !== fasciaUtente}>
            Tu<span class="visually-hidden"> (il tuo voto)</span>
          </span>
        </div>
        <div class="riga__barra">
          <span class="traccia" aria-hidden="true">
            <span class="barra" style={`--n:${r.blocchi};--i:${r.i}`}></span>
          </span>
          <span class="riga__count"><span data-count>{r.count}</span><span class="visually-hidden"> voti</span></span>
        </div>
      </li>
    ))}
  </ol>

  <p class="hist__insufficienti" hidden={live || sufficienti} data-insufficienti>
    <span class="label">Dati insufficienti.</span>
    Servono almeno {MIN_RISPOSTE} risposte per mostrare la distribuzione (finora <span data-finora>{totale}</span>).
  </p>

  <div class="voto">
    <h3 class="voto__domanda" id={`${uid}-domanda`}>
      <span class="cursore" aria-hidden="true"></span>E tu, quanto hai studiato?
    </h3>
    <div class="voto__pulsanti" role="group" aria-labelledby={`${uid}-domanda`}>
      {FASCE_STUDIO.map((fascia) => (
        <button type="button" class="btn-px label voto__btn" data-voto={fascia} aria-pressed={fascia === fasciaUtente ? 'true' : 'false'}>
          {fascia}
        </button>
      ))}
    </div>

    {live && (
      <div class="accesso" data-accesso hidden>
        <p class="accesso__testo">
          Per votare accedi con il tuo account <strong>@universitadipavia.it</strong>: serve solo a garantire un voto per studente.
        </p>
        <button type="button" class="btn-px btn-px--accent label" data-accedi>Accedi con Google</button>
      </div>
    )}

    <p class="voto__stato" role="status" aria-live="polite" data-stato></p>
    <p class="voto__nota">
      Un voto per studente, con account istituzionale.
      <span data-account hidden>
        Accesso come <strong data-email></strong> · <button type="button" class="voto__link" data-esci>Esci</button>
      </span>
    </p>
  </div>
</section>

<script>
  import { isFascia, type FasciaStudio } from '../../lib/fasce';
  import { blocchiPerFascia, conteggiVuoti, MIN_RISPOSTE, ritardoTu, type Conteggi } from '../../lib/histogram';
  import type { Session } from '@supabase/supabase-js';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => root.querySelector<T>(sel)!;

  /** Barre, conteggi e "TU" a partire dai dati. */
  function render(hist: HTMLElement, counts: Conteggi, totale: number, mia: FasciaStudio | null) {
    const blocchi = blocchiPerFascia(counts);
    hist.style.setProperty('--tu-delay', `${ritardoTu(blocchi)}ms`);
    $(hist, '[data-totale]').textContent = `${totale} ${totale === 1 ? 'risposta' : 'risposte'}`;
    const sufficienti = totale >= MIN_RISPOSTE;
    $(hist, '[data-righe]').hidden = !sufficienti;
    $(hist, '[data-insufficienti]').hidden = sufficienti;
    $(hist, '[data-finora]').textContent = String(totale);
    hist.querySelectorAll<HTMLElement>('.riga').forEach((riga, i) => {
      const fascia = riga.dataset.fascia as FasciaStudio;
      $(riga, '.barra').style.setProperty('--n', String(blocchi[i]));
      $(riga, '[data-count]').textContent = String(counts[fascia] ?? 0);
      segnaMia(riga, fascia === mia);
    });
    premuto(hist, mia);
  }

  function segnaMia(riga: HTMLElement, mia: boolean) {
    riga.classList.toggle('riga--tu', mia);
    $(riga, '.tag--tu').hidden = !mia;
  }

  function premuto(hist: HTMLElement, fascia: string | null) {
    hist.querySelectorAll<HTMLButtonElement>('[data-voto]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.voto === fascia)));
  }

  /** Animazione al primo ingresso nel viewport, quando `pronto` si risolve. */
  function animaQuandoVisibile(hist: HTMLElement, pronto: Promise<unknown>) {
    if (reduce || !('IntersectionObserver' in window)) return;
    hist.classList.add('is-armed');
    const visibile = new Promise<void>((resolve) => {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            resolve();
          }
        },
        // Soglia 0 + margine: parte anche se il pannello è più alto dello
        // schermo (telefono in orizzontale), quando ne è visibile un pezzo.
        { threshold: 0, rootMargin: '0px 0px -15% 0px' },
      );
      io.observe(hist);
    });
    Promise.all([visibile, pronto]).finally(() => hist.classList.replace('is-armed', 'is-playing'));
  }

  // --- Modalità statica: voto solo locale -----------------------------------
  for (const hist of document.querySelectorAll<HTMLElement>('[data-hist]:not([data-live])')) {
    animaQuandoVisibile(hist, Promise.resolve());
    hist.querySelectorAll<HTMLButtonElement>('[data-voto]').forEach((btn) => {
      btn.addEventListener('click', () => {
        premuto(hist, btn.dataset.voto!);
        hist.querySelectorAll<HTMLElement>('.riga').forEach((riga) => segnaMia(riga, riga.dataset.fascia === btn.dataset.voto));
      });
    });
  }

  // --- Modalità collegata (Supabase) ---------------------------------------
  const liveHists = [...document.querySelectorAll<HTMLElement>('[data-hist][data-live]')];
  if (liveHists.length > 0) {
    // Il client Supabase è in un chunk separato, caricato solo dove serve.
    const sb = import('../../lib/supabase');
    const PENDING_KEY = 'guide:voto-in-sospeso';
    type Pending = { moduloId: string; fascia: FasciaStudio; anchor: string };
    let session: Session | null = null;

    const stato = (hist: HTMLElement, msg: string) => ($(hist, '[data-stato]').textContent = msg);

    async function carica(hist: HTMLElement) {
      const { supabase } = await sb;
      const moduloId = hist.dataset.modulo!;
      const [conteggi, mio] = await Promise.all([
        supabase.rpc('study_time_counts', { p_modulo_id: moduloId }),
        session
          ? supabase.from('study_time_votes').select('fascia').eq('modulo_id', moduloId).maybeSingle()
          : Promise.resolve({ data: null, error: null }),
      ]);
      if (conteggi.error) throw conteggi.error;
      if (mio.error) throw mio.error;

      const counts = conteggiVuoti();
      let totale = 0;
      for (const r of (conteggi.data ?? []) as { fascia: string; voti: number }[]) {
        if (!isFascia(r.fascia)) continue;
        counts[r.fascia] = Number(r.voti);
        totale += Number(r.voti);
      }
      render(hist, counts, totale, mio.data && isFascia(mio.data.fascia) ? mio.data.fascia : null);
    }

    async function vota(hist: HTMLElement, fascia: FasciaStudio) {
      const { supabase } = await sb;
      stato(hist, 'Invio del voto…');
      const { error } = await supabase.rpc('cast_study_time_vote', { p_modulo_id: hist.dataset.modulo!, p_fascia: fascia });
      if (error) {
        stato(hist, 'Non è stato possibile registrare il voto. Riprova più tardi.');
        return;
      }
      stato(hist, 'Voto registrato. Grazie!');
      await carica(hist).catch(() => {});
    }

    /** Riga "Accesso come … · Esci" su tutti gli istogrammi della pagina. */
    function aggiornaAccount() {
      for (const hist of liveHists) {
        $(hist, '[data-account]').hidden = !session;
        $(hist, '[data-email]').textContent = session?.user.email ?? '';
        if (session) $(hist, '[data-accesso]').hidden = true;
      }
    }

    function leggiPending(): Pending | null {
      try {
        const p = JSON.parse(sessionStorage.getItem(PENDING_KEY) ?? 'null');
        sessionStorage.removeItem(PENDING_KEY);
        return p && isFascia(p.fascia) ? p : null;
      } catch {
        return null;
      }
    }

    (async () => {
      const { supabase, DOMINIO_ATENEO } = await sb;

      // Al ritorno da Google il client scambia il ?code= con la sessione
      // (PKCE) durante l'inizializzazione; getSession() la attende.
      session = (await supabase.auth.getSession()).data.session;

      // Ripulisce l'URL dai parametri del login, mostrando l'eventuale errore
      // (es. account rifiutato dall'hook perché non d'ateneo).
      const url = new URL(location.href);
      const erroreLogin = url.searchParams.get('error_description');
      if (['code', 'error', 'error_code', 'error_description'].some((k) => url.searchParams.has(k))) {
        ['code', 'error', 'error_code', 'error_description'].forEach((k) => url.searchParams.delete(k));
        history.replaceState(null, '', url);
      }

      if (session && !(session.user.email ?? '').toLowerCase().endsWith(`@${DOMINIO_ATENEO}`)) {
        // Non dovrebbe accadere (hook lato Auth + RLS), ma non lasciamo
        // aperta una sessione con un account non ammesso.
        await supabase.auth.signOut();
        session = null;
      }
      aggiornaAccount();

      const pending = leggiPending();

      for (const hist of liveHists) {
        const moduloId = hist.dataset.modulo!;
        const daVotare = session && pending?.moduloId === moduloId ? pending.fascia : null;

        if (erroreLogin && pending?.moduloId === moduloId) {
          stato(hist, `Accesso non riuscito. Usa un account @${DOMINIO_ATENEO}.`);
        }

        animaQuandoVisibile(
          hist,
          (daVotare ? vota(hist, daVotare) : carica(hist)).catch(() => {
            $(hist, '[data-totale]').textContent = 'Voti non disponibili';
            stato(hist, 'Al momento non è possibile caricare i voti.');
          }),
        );

        hist.querySelectorAll<HTMLButtonElement>('[data-voto]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const fascia = btn.dataset.voto as FasciaStudio;
            if (session) {
              vota(hist, fascia);
              return;
            }
            hist.dataset.inSospeso = fascia;
            premuto(hist, fascia);
            $(hist, '[data-accesso]').hidden = false;
            stato(hist, '');
            $(hist, '[data-accedi]').focus();
          });
        });

        $(hist, '[data-accedi]').addEventListener('click', async () => {
          const fascia = hist.dataset.inSospeso;
          // Il voto scelto sopravvive al giro su Google in sessionStorage.
          if (isFascia(fascia)) {
            const anchor = hist.closest<HTMLElement>('[data-modulo-panel]')?.id ?? '';
            try {
              sessionStorage.setItem(PENDING_KEY, JSON.stringify({ moduloId, fascia, anchor } satisfies Pending));
            } catch {
              /* senza storage il voto andrà ripetuto dopo l'accesso */
            }
          }
          stato(hist, 'Apertura di Google…');
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: location.origin + location.pathname,
              // Suggerisce a Google gli account del dominio d'ateneo; il
              // vincolo vero è lato server (hook Auth + RLS).
              queryParams: { hd: DOMINIO_ATENEO, prompt: 'select_account' },
            },
          });
          if (error) stato(hist, 'Non è stato possibile avviare l’accesso con Google.');
        });

        $(hist, '[data-esci]').addEventListener('click', async () => {
          await supabase.auth.signOut();
          session = null;
          aggiornaAccount();
          liveHists.forEach((h) => {
            stato(h, '');
            carica(h).catch(() => {});
          });
        });
      }

      // Riporta lo studente al modulo da cui aveva votato (schede dei moduli).
      if (pending?.anchor && location.hash.slice(1) !== pending.anchor) {
        location.hash = pending.anchor;
      }
    })();
  }
</script>

<style>
  .hist__titolo {
    color: var(--accent);
    margin: 0;
  }
  .hist__totale {
    color: var(--caption);
    margin: 4px 0 16px;
  }

  .hist__righe {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .riga {
    margin: 0 0 12px;
  }
  .riga__testa {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 28px;
  }
  .riga__fascia {
    color: var(--text-2);
  }
  .riga--tu .riga__fascia {
    color: var(--you);
  }
  .riga__barra {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  /* 10 blocchi da 12px + 4px di spazio = 160px (l'ultimo spazio è vuoto). */
  .traccia {
    position: relative;
    flex: 0 0 auto;
    width: 160px;
    height: 12px;
    background: repeating-linear-gradient(to right, var(--bg) 0 12px, transparent 12px 16px);
  }
  .barra {
    --c: var(--accent);
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--n) * 16px);
    background: repeating-linear-gradient(to right, var(--c) 0 12px, transparent 12px 16px);
  }
  .riga--tu .barra {
    --c: var(--you);
  }
  .riga__count {
    font-weight: 700;
    color: var(--text);
  }

  .tag {
    padding: 0 4px;
    line-height: 20px;
  }
  .tag--rappr {
    color: var(--text);
    box-shadow: inset 0 0 0 2px var(--text);
    padding: 0 6px;
  }
  .tag--tu {
    background: var(--you);
    color: var(--bg);
  }

  /* --- Animazioni (a scatti) --- */
  /* In attesa del viewport: barre vuote e "TU" nascosto. */
  .hist.is-armed .barra {
    width: 0;
  }
  .hist.is-armed .tag--tu {
    visibility: hidden;
  }
  /* Un blocco per fotogramma: steps(n) con n = numero di blocchi. */
  .hist.is-playing .barra {
    animation: riempi calc(var(--n) * var(--ms-blocco)) steps(var(--n), end) backwards;
    animation-delay: calc(var(--i) * 150ms);
  }
  .hist.is-playing .tag--tu {
    animation: appari 1ms steps(1, end) backwards;
    animation-delay: var(--tu-delay);
  }
  @keyframes riempi {
    from { width: 0; }
  }
  @keyframes appari {
    from { visibility: hidden; }
  }

  .hist__insufficienti {
    color: var(--text-2);
    background: var(--bg);
    padding: 12px;
    margin: 0 0 16px;
  }
  .hist__insufficienti .label {
    display: block;
    color: var(--warn);
    margin-bottom: 4px;
  }

  .voto {
    margin-top: 24px;
  }
  .voto__domanda {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: var(--text);
  }
  .cursore {
    flex: 0 0 auto;
    width: 12px;
    height: 20px;
    background: var(--accent);
    animation: lampeggia 1s steps(1, end) infinite;
  }
  @keyframes lampeggia {
    50% { visibility: hidden; }
  }
  .voto__pulsanti {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .voto__btn {
    background: var(--bg);
    color: var(--text-2);
    box-shadow: inset 0 0 0 2px var(--border-off);
  }
  .voto__btn[aria-pressed='true'] {
    background: var(--you);
    color: var(--bg);
    box-shadow: none;
  }
  .voto__nota {
    color: var(--caption);
    font-size: 14px;
    margin: 12px 0 0;
  }

  @media (forced-colors: active) {
    .traccia { outline: 1px solid CanvasText; background: Canvas; }
    .barra { --c: CanvasText; }
    .tag { outline: 2px solid CanvasText; }
    .voto__btn[aria-pressed='true'] { outline: 4px solid Highlight; }
  }

  /* --- Accesso con Google --- */
  .accesso {
    margin-top: 16px;
    padding: 12px;
    background: var(--bg);
  }
  .accesso__testo {
    color: var(--text-2);
    margin: 0 0 12px;
  }
  .voto__stato:empty {
    display: none;
  }
  .voto__stato {
    color: var(--text);
    margin: 12px 0 0;
  }
  .voto__link {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
  }
</style>
