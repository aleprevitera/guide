---
// Istogramma del tempo di studio votato dagli studenti. Solo UI: non è
// collegato a nessun backend e il voto resta nello stato della pagina.
import { FASCE_STUDIO, type FasciaStudio } from '../../content/config';

interface Props {
  /** Numero di voti per ciascuna fascia. */
  counts: Record<FasciaStudio, number>;
  /** Fascia stimata dal rappresentante (modulo.fascia_studio). */
  fasciaRappresentante?: FasciaStudio;
  /** Fascia votata dall'utente corrente, se ha già votato. */
  fasciaUtente?: FasciaStudio;
  /** Numero totale di risposte. */
  totale: number;
  /** Titolo della sezione (default: "Tempo di studio"). */
  titolo?: string;
}

const { counts, fasciaRappresentante, fasciaUtente, totale, titolo = 'Tempo di studio' } = Astro.props;

const MIN_RISPOSTE = 5;
const BLOCCHI = 10;
const MS_PER_BLOCCO = 70;
const SFALSAMENTO_MS = 150;

const uid = `hist-${Math.random().toString(36).slice(2, 8)}`;
const sufficienti = totale >= MIN_RISPOSTE;
const max = Math.max(...FASCE_STUDIO.map((f) => counts[f] ?? 0), 1);

const righe = FASCE_STUDIO.map((fascia, i) => {
  const count = counts[fascia] ?? 0;
  // Lunghezza proporzionale alla fascia più votata, arrotondata al blocco;
  // almeno un blocco se c'è almeno un voto.
  const blocchi = count > 0 ? Math.max(1, Math.round((count / max) * BLOCCHI)) : 0;
  return { fascia, count, blocchi, i };
});

// "TU" compare quando l'ultima barra ha finito di riempirsi.
const tuDelayMs = Math.max(...righe.map((r) => r.i * SFALSAMENTO_MS + r.blocchi * MS_PER_BLOCCO), 0);
---

<section class="hist panel px-border" aria-labelledby={`${uid}-titolo`} data-hist style={`--tu-delay:${tuDelayMs}ms;--ms-blocco:${MS_PER_BLOCCO}ms`}>
  <h2 class="hist__titolo label" id={`${uid}-titolo`}>{titolo}</h2>
  <p class="hist__totale label">{totale} {totale === 1 ? 'risposta' : 'risposte'}</p>

  {sufficienti ? (
    <ol class="hist__righe" aria-label="Distribuzione delle risposte per fascia">
      {righe.map((r) => (
        <li class:list={['riga', { 'riga--tu': r.fascia === fasciaUtente }]} data-fascia={r.fascia}>
          <div class="riga__testa">
            <span class="riga__fascia label">{r.fascia}</span>
            {r.fascia === fasciaRappresentante && (
              <span class="tag tag--rappr label" title="Stima del rappresentante">
                Rappr.<span class="visually-hidden"> (stima del rappresentante)</span>
              </span>
            )}
            <span class="tag tag--tu label" hidden={r.fascia !== fasciaUtente}>
              Tu<span class="visually-hidden"> (il tuo voto)</span>
            </span>
          </div>
          <div class="riga__barra">
            <span class="traccia" aria-hidden="true">
              <span class="barra" style={`--n:${r.blocchi};--i:${r.i}`}></span>
            </span>
            <span class="riga__count">{r.count}<span class="visually-hidden"> {r.count === 1 ? 'voto' : 'voti'}</span></span>
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p class="hist__insufficienti">
      <span class="label">Dati insufficienti.</span>
      Servono almeno {MIN_RISPOSTE} risposte per mostrare la distribuzione (finora {totale}).
    </p>
  )}

  <div class="voto">
    <h3 class="voto__domanda" id={`${uid}-domanda`}>
      <span class="cursore" aria-hidden="true"></span>E tu, quanto hai studiato?
    </h3>
    <div class="voto__pulsanti" role="group" aria-labelledby={`${uid}-domanda`}>
      {FASCE_STUDIO.map((fascia) => (
        <button type="button" class="btn-px label voto__btn" data-voto={fascia} aria-pressed={fascia === fasciaUtente ? 'true' : 'false'}>
          {fascia}
        </button>
      ))}
    </div>
    <p class="voto__nota">Un voto per studente, con account istituzionale.</p>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const hist of document.querySelectorAll<HTMLElement>('[data-hist]')) {
    // Animazione al primo ingresso nel viewport. Senza JS (o con
    // movimento ridotto) le barre sono già piene.
    if (!reduce && 'IntersectionObserver' in window) {
      hist.classList.add('is-armed');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            hist.classList.replace('is-armed', 'is-playing');
            io.disconnect();
          }
        },
        // Soglia 0 + margine: parte anche se il pannello è più alto dello
        // schermo (telefono in orizzontale), quando ne è visibile un pezzo.
        { threshold: 0, rootMargin: '0px 0px -15% 0px' },
      );
      io.observe(hist);
    }

    // Voto solo locale: aggiorna aria-pressed e sposta "TU" sulla riga scelta.
    const buttons = [...hist.querySelectorAll<HTMLButtonElement>('[data-voto]')];
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const fascia = btn.dataset.voto;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
        for (const riga of hist.querySelectorAll<HTMLElement>('.riga')) {
          const mia = riga.dataset.fascia === fascia;
          riga.classList.toggle('riga--tu', mia);
          const tu = riga.querySelector<HTMLElement>('.tag--tu');
          if (tu) tu.hidden = !mia;
        }
      });
    }
  }
</script>

<style>
  .hist__titolo {
    color: var(--accent);
    margin: 0;
  }
  .hist__totale {
    color: var(--caption);
    margin: 4px 0 16px;
  }

  .hist__righe {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .riga {
    margin: 0 0 12px;
  }
  .riga__testa {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 28px;
  }
  .riga__fascia {
    color: var(--text-2);
  }
  .riga--tu .riga__fascia {
    color: var(--you);
  }
  .riga__barra {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  /* 10 blocchi da 12px + 4px di spazio = 160px (l'ultimo spazio è vuoto). */
  .traccia {
    position: relative;
    flex: 0 0 auto;
    width: 160px;
    height: 12px;
    background: repeating-linear-gradient(to right, var(--bg) 0 12px, transparent 12px 16px);
  }
  .barra {
    --c: var(--accent);
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--n) * 16px);
    background: repeating-linear-gradient(to right, var(--c) 0 12px, transparent 12px 16px);
  }
  .riga--tu .barra {
    --c: var(--you);
  }
  .riga__count {
    font-weight: 700;
    color: var(--text);
  }

  .tag {
    padding: 0 4px;
    line-height: 20px;
  }
  .tag--rappr {
    color: var(--text);
    box-shadow: inset 0 0 0 2px var(--text);
    padding: 0 6px;
  }
  .tag--tu {
    background: var(--you);
    color: var(--bg);
  }

  /* --- Animazioni (a scatti) --- */
  /* In attesa del viewport: barre vuote e "TU" nascosto. */
  .hist.is-armed .barra {
    width: 0;
  }
  .hist.is-armed .tag--tu {
    visibility: hidden;
  }
  /* Un blocco per fotogramma: steps(n) con n = numero di blocchi. */
  .hist.is-playing .barra {
    animation: riempi calc(var(--n) * var(--ms-blocco)) steps(var(--n), end) backwards;
    animation-delay: calc(var(--i) * 150ms);
  }
  .hist.is-playing .tag--tu {
    animation: appari 1ms steps(1, end) backwards;
    animation-delay: var(--tu-delay);
  }
  @keyframes riempi {
    from { width: 0; }
  }
  @keyframes appari {
    from { visibility: hidden; }
  }

  .hist__insufficienti {
    color: var(--text-2);
    background: var(--bg);
    padding: 12px;
    margin: 0 0 16px;
  }
  .hist__insufficienti .label {
    display: block;
    color: var(--warn);
    margin-bottom: 4px;
  }

  .voto {
    margin-top: 24px;
  }
  .voto__domanda {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: var(--text);
  }
  .cursore {
    flex: 0 0 auto;
    width: 12px;
    height: 20px;
    background: var(--accent);
    animation: lampeggia 1s steps(1, end) infinite;
  }
  @keyframes lampeggia {
    50% { visibility: hidden; }
  }
  .voto__pulsanti {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .voto__btn {
    background: var(--bg);
    color: var(--text-2);
    box-shadow: inset 0 0 0 2px var(--border-off);
  }
  .voto__btn[aria-pressed='true'] {
    background: var(--you);
    color: var(--bg);
    box-shadow: none;
  }
  .voto__nota {
    color: var(--caption);
    font-size: 14px;
    margin: 12px 0 0;
  }

  @media (forced-colors: active) {
    .traccia { outline: 1px solid CanvasText; background: Canvas; }
    .barra { --c: CanvasText; }
    .tag { outline: 2px solid CanvasText; }
    .voto__btn[aria-pressed='true'] { outline: 4px solid Highlight; }
  }
</style>
