---
// Lettera dei creatori sulla mission del progetto.
// Modificabile SOLO qui nel codice (non da Decap). TODO testo: il testo
// definitivo lo forniscono i creatori; quello sotto è segnaposto.
import PixelIcon from '../common/PixelIcon.astro';

const firme = ['Francesco Ruspino', 'Alessandro Gavino Previtera'];
---

<section class="lettera panel px-border" aria-labelledby="lettera-titolo">
  <div class="lettera__testa">
    <PixelIcon name="letter" size={32} />
    <h2 id="lettera-titolo" class="label">Lettera dai creatori</h2>
  </div>

  <div class="lettera__corpo">
    <p>Cara studentessa, caro studente,</p>
    <p>
      <em>[Testo in arrivo.]</em> Qui racconteremo perché abbiamo creato queste guide, a chi sono
      rivolte e come vogliamo che crescano, anno dopo anno, grazie a chi le usa.
    </p>
  </div>

  <p class="lettera__firme">
    {firme.map((f) => <span class="lettera__firma">{f}</span>)}
  </p>
</section>

<style>
  .lettera {
    background: var(--panel);
  }
  .lettera__testa {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .lettera__testa h2 {
    margin: 0;
    color: var(--accent);
  }
  .lettera__corpo {
    color: var(--text-2);
  }
  /* Le due firme una sotto l'altra, centrate. */
  .lettera__firme {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 4px solid var(--bg);
  }
  .lettera__firma {
    text-align: center;
    line-height: 1.2;
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    /* Un po' più piccolo dei titoli: ogni nome sta su una riga a 375px. */
    font-size: 20px;
    color: var(--text);
    -webkit-font-smoothing: none;
  }
</style>
