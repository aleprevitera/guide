---
// Elenco di guide come card cliccabili, usato in /guide/ e nelle pagine degli
// anni. Ogni card ha il colore e il terreno del suo mondo (anno di corso) e
// una riga di "statistiche da videogioco" ricavata solo dai dati della guida
// (niente da aggiungere a mano: i rappresentanti compilano Decap come sempre).
import type { CollectionEntry } from 'astro:content';
import PixelIcon from '../common/PixelIcon.astro';
import { cfuGuida, proveEsame, tempoBreve } from '../../lib/guide';
import { MONDI, stileMondo } from '../../lib/mondi';

interface Props {
  entries: CollectionEntry<'guide'>[];
}

const guide = [...Astro.props.entries]
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((entry) => {
    const prove = proveEsame(entry.data);
    return {
      href: `/guide/${entry.id}/`,
      // Il titolo della card diventa il titolo della guida (View Transition).
      vt: entry.data.id ? `guida-${entry.data.id}` : undefined,
      title: entry.data.title,
      stile: stileMondo(entry.data.anno_di_corso),
      terreno: MONDI[entry.data.anno_di_corso].icona,
      cfu: cfuGuida(entry.data),
      prove,
      tipo: prove.scritto && prove.orale ? 'Scritto + orale' : prove.scritto ? 'Scritto' : prove.orale ? 'Orale' : undefined,
      tempo: tempoBreve(entry.data),
      moduli: entry.data.moduli.length,
      // Difficoltà: feedback degli studenti, caricata nel browser solo con una sessione.
      idModuli: entry.data.moduli.map((m) => m.id).filter(Boolean).join(','),
    };
  });
---

<ul class="guide-list" data-rivela>
  {guide.map((g) => (
    <li>
      <a class="guida px-border" href={g.href} style={g.stile}>
        <span class="guida__corpo">
          <span class="guida__titolo" style={g.vt && `view-transition-name:${g.vt}`}>{g.title}</span>
          {(g.cfu || g.tipo || g.tempo || g.moduli > 1 || g.idModuli) && (
            <span class="hud label">
              {g.cfu && (
                <span class="stat"><PixelIcon name="moneta" size={16} />{g.cfu} CFU</span>
              )}
              {g.tipo && (
                <span class="stat">
                  {g.prove.scritto && <PixelIcon name="penna" size={16} />}
                  {g.prove.orale && <PixelIcon name="fumetto" size={16} />}
                  {g.tipo}
                </span>
              )}
              {g.tempo && (
                <span class="stat"><PixelIcon name="clessidra" size={16} /><span class="visually-hidden">Tempo stimato: </span>{g.tempo}</span>
              )}
              {g.moduli > 1 && (
                <span class="stat"><PixelIcon name="moduli" size={16} />{g.moduli} moduli</span>
              )}
              {g.idModuli && <span class="stat" data-diff-card data-moduli={g.idModuli} hidden></span>}
            </span>
          )}
        </span>
        <span class="terreno" data-terreno={g.terreno} aria-hidden="true"></span>
      </a>
    </li>
  ))}
</ul>

<script>
  import { EVENTO_AUTH, statoAuth, type StatoAuth } from '../../lib/auth';
  import { conteggi } from '../../lib/feedback';
  import { ETICHETTA, LIVELLI, mediana, teschiHtml, type Livello } from '../../lib/difficolta';

  // Per chi ha fatto l'accesso: la difficoltà del modulo più difficile della
  // guida (mediana dei voti, solo con abbastanza voti). Una chiamata sola per
  // tutte le card della pagina.
  const card = [...document.querySelectorAll<HTMLElement>('[data-diff-card]')];
  async function mostra() {
    const moduli = [...new Set(card.flatMap((c) => c.dataset.moduli!.split(',')))];
    try {
      const mappa = await conteggi(moduli, 'difficolta');
      for (const c of card) {
        const livelli = c.dataset.moduli!.split(',').map((m) => mediana(mappa.get(m) ?? {}).livello).filter((l): l is Livello => !!l);
        if (livelli.length === 0) continue;
        const peggiore = livelli.reduce((a, b) => (LIVELLI.indexOf(b) > LIVELLI.indexOf(a) ? b : a));
        c.innerHTML = `${teschiHtml(peggiore)}<span class="visually-hidden">Difficoltà: </span>${ETICHETTA[peggiore]}`;
        c.hidden = false;
      }
    } catch {
      /* niente statistica */
    }
  }
  const applica = ({ session }: StatoAuth) => {
    if (session) mostra();
    else card.forEach((c) => (c.hidden = true));
  };
  if (card.length > 0) {
    statoAuth().then(applica);
    window.addEventListener(EVENTO_AUTH, (e) => applica((e as CustomEvent<StatoAuth>).detail));
  }
</script>

<style>
  .guide-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guide-list li {
    margin: 0;
  }
  .guida {
    display: block;
    min-height: 44px;
    margin-top: 16px;
    margin-bottom: 20px;
    background: var(--panel);
    color: var(--text);
    text-decoration: none;
    transition: transform 80ms steps(1, end);
  }
  @media (hover: hover) and (pointer: fine) {
    .guida:hover {
      transform: translateY(-2px);
      --px-c: var(--mondo-chiaro, var(--accent));
    }
  }
  .guida:active {
    transform: translateY(4px);
    --px-c: var(--mondo-chiaro, var(--accent));
  }
  /* Fascia del colore del mondo sul lato sinistro. */
  .guida__corpo {
    display: block;
    padding: 16px 16px 16px 28px;
    box-shadow: inset 12px 0 0 0 var(--mondo, var(--chip));
  }
  .guida__titolo {
    display: block;
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--h2-size);
    line-height: 1.2;
    margin-bottom: 12px;
    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: grayscale;
  }
  /* Statistiche "HUD": icona pixel + valore su fondo scuro. */
  .hud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .stat {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    background: var(--bg);
    color: var(--text);
  }
  .stat :global(.teschi) {
    display: inline-flex;
    gap: 2px;
  }
  @media (forced-colors: active) {
    .guida { outline: 2px solid CanvasText; }
    .stat { outline: 1px solid CanvasText; }
  }
</style>
