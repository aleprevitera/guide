---
import type { CollectionEntry } from 'astro:content';
import PixelIcon from '../common/PixelIcon.astro';

type Modulo = CollectionEntry<'guide'>['data']['moduli'][number];

interface Props {
  modulo: Modulo;
}

const { modulo } = Astro.props;

// Solo le righe con un dato: nessun "—" segnaposto.
const righe: { etichetta: string; valore: string }[] = [];
const add = (etichetta: string, valore: string | number | undefined) => {
  if (valore !== undefined && valore !== '') righe.push({ etichetta, valore: String(valore) });
};

add("Tipo d'esame", modulo.exam_type);
add('Docenti', modulo.professors.map((p) => p.nome).join(', ') || undefined);
add('Preappello', modulo.preappello);
add('Durata orale', modulo.durata_orale_min ? `${modulo.durata_orale_min} min circa` : undefined);
add('Frequenza', modulo.frequenza);
add('Tempo stimato', modulo.study_time ?? modulo.fascia_studio);
add('CFU', modulo.cfu);
add('Semestre', modulo.semestre);

// Difficoltà: è un feedback degli studenti (contenuto "extra"), non il campo
// `difficolta` dell'autore, che non viene più mostrato. Il verdetto (mediana
// dei voti) arriva dal browser solo con una sessione; senza, il lucchetto.
const conDifficolta = !!modulo.id;
---

{(righe.length > 0 || conDifficolta) && (
  <section class="scheda panel px-border" aria-label="Scheda esame">
    <p class="scheda__titolo label" data-pagefind-ignore>Scheda esame</p>
    <dl class="scheda__dl">
      {righe.map((r) => (
        <div class="scheda__riga">
          <dt class="label">{r.etichetta}<span class="visually-hidden">: </span></dt>
          <dd>{r.valore}</dd>
        </div>
      ))}
      {conDifficolta && (
        <div class="scheda__riga">
          <dt class="label">Difficoltà<span class="visually-hidden">: </span></dt>
          <dd class="difficolta" data-diff-scheda data-modulo={modulo.id}>
            <span class="difficolta__bloccata">
              <PixelIcon name="lock" size={16} />
              Accedi per vederla (voto degli studenti)
            </span>
          </dd>
        </div>
      )}
    </dl>
  </section>
)}

<script>
  import { EVENTO_AUTH, statoAuth, type StatoAuth } from '../../lib/auth';
  import { conteggi, EVENTO_FEEDBACK } from '../../lib/feedback';
  import { ETICHETTA, mediana, teschiHtml } from '../../lib/difficolta';

  const celle = [...document.querySelectorAll<HTMLElement>('[data-diff-scheda]')];
  if (celle.length > 0) {
    const bloccato = celle.map((c) => c.innerHTML);
    let attivo = false;

    async function aggiorna() {
      const moduli = celle.map((c) => c.dataset.modulo!);
      try {
        const mappa = await conteggi(moduli, 'difficolta');
        for (const cella of celle) {
          const { livello, totale } = mediana(mappa.get(cella.dataset.modulo!) ?? {});
          cella.innerHTML = livello
            ? `${teschiHtml(livello)} <span>${ETICHETTA[livello]}</span> <span class="difficolta__nota">(${totale} voti)</span>`
            : `<span class="difficolta__nota">Pochi voti finora (${totale}): vota qui sotto</span>`;
        }
      } catch {
        /* resta il testo precedente */
      }
    }

    const applica = ({ session }: StatoAuth) => {
      attivo = !!session;
      if (attivo) aggiorna();
      else celle.forEach((c, i) => (c.innerHTML = bloccato[i]));
    };
    statoAuth().then(applica);
    window.addEventListener(EVENTO_AUTH, (e) => applica((e as CustomEvent<StatoAuth>).detail));
    window.addEventListener(EVENTO_FEEDBACK, (e) => {
      if (attivo && (e as CustomEvent<{ tipo: string }>).detail.tipo === 'difficolta') aggiorna();
    });
  }
</script>

<style>
  .scheda__titolo {
    color: var(--accent);
    margin: 0 0 12px;
  }
  .scheda__dl {
    margin: 0;
  }
  .scheda__riga {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 16px;
    padding: 8px 0;
    border-top: 4px solid var(--bg);
  }
  .scheda__riga:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (min-width: 480px) {
    .scheda__riga {
      grid-template-columns: 168px 1fr;
      align-items: baseline;
    }
  }
  .scheda__riga dt {
    color: var(--caption);
  }
  .scheda__riga dd {
    margin: 0;
    color: var(--text);
  }
  .difficolta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .difficolta :global(.teschi) {
    display: inline-flex;
    gap: 2px;
  }
  .difficolta__bloccata,
  .difficolta :global(.difficolta__nota) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--caption);
    font-size: 14px;
  }
</style>
