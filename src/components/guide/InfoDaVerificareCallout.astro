---
import type { CollectionEntry } from 'astro:content';
import SafeMarkdown from '../common/SafeMarkdown.astro';
import PixelIcon from '../common/PixelIcon.astro';

type Item = CollectionEntry<'guide'>['data']['info_da_verificare'][number];

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="callout panel px-border px-border--warn" aria-labelledby="info-da-verificare" data-pagefind-ignore>
    <div class="callout__head">
      <PixelIcon name="alert" size={24} />
      <h2 id="info-da-verificare" class="callout__title label">Informazioni da verificare</h2>
    </div>
    <ul>
      {items.map((item) => (
        <li>
          <strong>{item.campo}</strong>
          {item.nota && <div class="callout__nota"><SafeMarkdown text={item.nota} /></div>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .callout {
    background: var(--bg);
    margin-top: 40px;
  }
  .callout__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .callout__title {
    margin: 0;
    color: var(--warn);
  }
  .callout ul {
    margin: 0;
  }
  .callout li {
    margin-bottom: 12px;
  }
  .callout li:last-child {
    margin-bottom: 0;
  }
  .callout li::marker {
    color: var(--warn);
  }
  .callout__nota {
    color: var(--text-2);
    margin-top: 4px;
  }
</style>
