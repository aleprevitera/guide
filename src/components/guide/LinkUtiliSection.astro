---
import type { CollectionEntry } from 'astro:content';

type LinkUtile = CollectionEntry<'guide'>['data']['link_utili'][number];

interface Props {
  links: LinkUtile[];
}

const { links } = Astro.props;
---

{links.length > 0 && (
  <section class="link-utili">
    <h2>Link utili</h2>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">{link.etichetta}</a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .link-utili {
    padding: 1.5rem 0;
    border-top: 1px solid #e2e8f0;
  }
  .link-utili h2 {
    margin: 0 0 0.75rem;
  }
  .link-utili ul {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
