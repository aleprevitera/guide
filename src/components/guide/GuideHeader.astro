---
import type { CollectionEntry } from 'astro:content';
import SafeMarkdown from '../common/SafeMarkdown.astro';
import { cfuGuida } from '../../lib/guide';

type GuideData = CollectionEntry<'guide'>['data'];

interface Props {
  data: GuideData;
}

const { data } = Astro.props;
const { title, sottotitolo, anno_di_corso, moduli, link_sbobine_generale, link_whatsapp_generale, descrizione_generale } = data;

const isIntegrato = moduli.length > 1;
const cfu = cfuGuida(data);
---

<header class="guide-header">
  <ul class="chips label" aria-label="In breve">
    <li class="chip chip--accent">{anno_di_corso}</li>
    {cfu && <li class="chip">{cfu} CFU</li>}
    {isIntegrato && <li class="chip">{moduli.length} moduli</li>}
  </ul>

  <h1>{title}</h1>
  {sottotitolo && <p class="guide-header__sottotitolo">{sottotitolo}</p>}

  {isIntegrato && descrizione_generale && (
    <div class="guide-header__descrizione">
      <SafeMarkdown text={descrizione_generale} />
    </div>
  )}

  {(link_sbobine_generale || link_whatsapp_generale) && (
    <p class="btn-row">
      {link_sbobine_generale && (
        <a class="btn-px btn-px--accent label" href={link_sbobine_generale} target="_blank" rel="noopener noreferrer">Sbobine</a>
      )}
      {link_whatsapp_generale && (
        <a class="btn-px label" href={link_whatsapp_generale} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      )}
    </p>
  )}
</header>

<style>
  .guide-header {
    margin-bottom: 24px;
  }
  .guide-header__sottotitolo {
    color: var(--text-2);
    font-size: 18px;
    margin: 0 0 16px;
  }
  .guide-header__descrizione {
    color: var(--text-2);
    margin-top: 16px;
  }
</style>
