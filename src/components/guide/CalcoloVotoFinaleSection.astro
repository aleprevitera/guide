---
import SafeMarkdown from '../common/SafeMarkdown.astro';

interface Props {
  testo?: string;
}

const { testo } = Astro.props;
---

{testo && (
  <section class="calcolo-voto">
    <h2>Calcolo del voto finale</h2>
    <SafeMarkdown text={testo} />
  </section>
)}

<style>
  .calcolo-voto {
    padding: 1.5rem 0;
    border-top: 1px solid #e2e8f0;
  }
  .calcolo-voto h2 {
    margin: 0 0 0.75rem;
  }
</style>
