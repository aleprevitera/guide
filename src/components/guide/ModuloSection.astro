---
import type { CollectionEntry } from 'astro:content';
import SafeMarkdown from '../common/SafeMarkdown.astro';

type Modulo = CollectionEntry<'guide'>['data']['moduli'][number];

interface Props {
  modulo: Modulo;
}

const { modulo } = Astro.props;
const {
  nome_modulo,
  cfu,
  semestre,
  difficolta,
  exam_type,
  link_sbobine,
  link_whatsapp,
  google_sheet_url,
  study_time,
  exam_details,
  program,
  material_tips,
  body,
  professors,
} = modulo;

const difficultyColor = !difficolta ? '' : difficolta <= 2 ? '#4caf50' : difficolta === 3 ? '#ff9800' : '#f44336';
const difficultyWidth = difficolta ? difficolta * 20 : 0;

const hasLinks = link_sbobine || link_whatsapp || google_sheet_url;
---

<section class="modulo">
  <h2>{nome_modulo}</h2>

  <dl class="modulo__facts">
    {cfu && (<div><dt>CFU</dt><dd class="badge">{cfu}</dd></div>)}
    {semestre && (<div><dt>Semestre</dt><dd class="badge">{semestre}</dd></div>)}
    {exam_type && (<div><dt>Tipo esame</dt><dd class="badge">{exam_type}</dd></div>)}
    {study_time && (<div><dt>Tempo di studio</dt><dd class="badge">{study_time}</dd></div>)}
  </dl>

  {difficolta && (
    <div class="difficulty">
      <span class="difficulty__label">Difficoltà</span>
      <span class="difficulty__track">
        <span class="difficulty__fill" style={`width:${difficultyWidth}%;background:${difficultyColor}`} />
      </span>
      <span class="difficulty__score">{difficolta}/5</span>
    </div>
  )}

  {hasLinks && (
    <p class="modulo__links">
      {link_sbobine && <a class="button" href={link_sbobine} target="_blank" rel="noopener noreferrer">Sbobine</a>}
      {link_whatsapp && <a class="button" href={link_whatsapp} target="_blank" rel="noopener noreferrer">Gruppo WhatsApp</a>}
      {google_sheet_url && <a class="button" href={google_sheet_url} target="_blank" rel="noopener noreferrer">Domande passate</a>}
    </p>
  )}

  {exam_details && (
    <div class="modulo__section">
      <h3>Modalità d'esame</h3>
      <SafeMarkdown text={exam_details} />
    </div>
  )}

  <div class="modulo__section">
    <h3>Programma</h3>
    <SafeMarkdown text={program} />
  </div>

  {material_tips && (
    <div class="modulo__section">
      <h3>Consigli e materiale</h3>
      <SafeMarkdown text={material_tips} />
    </div>
  )}

  {professors.length > 0 && (
    <div class="modulo__section">
      <h3>Docenti</h3>
      <table class="professors">
        <thead>
          <tr><th>Docente</th><th>Contatti</th><th>Stile/Domande</th></tr>
        </thead>
        <tbody>
          {professors.map((prof) => (
            <tr>
              <td>{prof.nome}</td>
              <td>{prof.email ? <a href={`mailto:${prof.email}`}>{prof.email}</a> : '—'}</td>
              <td>{prof.stile || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {body && (
    <div class="modulo__section">
      <h3>Note extra</h3>
      <SafeMarkdown text={body} />
    </div>
  )}
</section>

<style>
  .modulo {
    padding: 1.5rem 0;
    border-top: 1px solid #e2e8f0;
  }
  .modulo__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 0 0 1rem;
  }
  .modulo__facts dt {
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 0.15rem;
  }
  .modulo__facts dd {
    margin: 0;
  }
  .badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: #e2e8f0;
  }
  .difficulty {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }
  .difficulty__track {
    background: #e2e8f0;
    height: 8px;
    width: 130px;
    border-radius: 999px;
    overflow: hidden;
  }
  .difficulty__fill {
    display: block;
    height: 100%;
    border-radius: 999px;
  }
  .modulo__links {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .button {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 0.4rem;
    background: #0f766e;
    color: #fff;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .modulo__section {
    margin-bottom: 1.5rem;
  }
  .modulo__section h3 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .professors {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .professors th,
  .professors td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid #e2e8f0;
  }
</style>
