---
import type { CollectionEntry } from 'astro:content';
import SafeMarkdown from '../common/SafeMarkdown.astro';
import SchedaEsame from './SchedaEsame.astro';
import StudyTimeHistogram from '../feedback/StudyTimeHistogram.astro';
import DifficoltaFeedback from '../feedback/DifficoltaFeedback.astro';

type Modulo = CollectionEntry<'guide'>['data']['moduli'][number];

interface Props {
  modulo: Modulo;
  anchor: string;
  /** In una guida a più moduli mostra il nome del modulo in testa. */
  mostraNome: boolean;
}

const { modulo, anchor, mostraNome } = Astro.props;
const { nome_modulo, link_sbobine, link_whatsapp, google_sheet_url, exam_details, program, material_tips, body, professors } = modulo;

const hasLinks = link_sbobine || link_whatsapp || google_sheet_url;
// I nomi sono già nella scheda: la sezione serve solo se c'è altro da dire.
const docentiDettaglio = professors.filter((p) => p.email || p.stile);
---

<section class="modulo" id={anchor} aria-label={nome_modulo} data-modulo-panel>
  {mostraNome && <p class="modulo__nome label">Modulo · {nome_modulo}</p>}

  <SchedaEsame modulo={modulo} />

  {modulo.id && (
    <StudyTimeHistogram moduloId={modulo.id} titolo="Parere degli studenti" sottotitolo="Tempo di studio">
      <DifficoltaFeedback moduloId={modulo.id} />
    </StudyTimeHistogram>
  )}

  {hasLinks && (
    <p class="btn-row">
      {link_sbobine && <a class="btn-px btn-px--accent label" href={link_sbobine} target="_blank" rel="noopener noreferrer">Sbobine</a>}
      {link_whatsapp && <a class="btn-px label" href={link_whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>}
      {google_sheet_url && <a class="btn-px label" href={google_sheet_url} target="_blank" rel="noopener noreferrer">Domande passate</a>}
    </p>
  )}

  {exam_details && (
    <>
      <h2>Modalità d'esame</h2>
      <SafeMarkdown text={exam_details} />
    </>
  )}

  <h2>Programma</h2>
  <SafeMarkdown text={program} />

  {material_tips && (
    <>
      <h2>Consigli e materiale</h2>
      <SafeMarkdown text={material_tips} />
    </>
  )}

  {docentiDettaglio.length > 0 && (
    <>
      <h2>Docenti</h2>
      <ul class="docenti">
        {docentiDettaglio.map((prof) => (
          <li>
            <strong>{prof.nome}</strong>
            {prof.email && <> · <a href={`mailto:${prof.email}`}>{prof.email}</a></>}
            {prof.stile && <p class="docenti__stile">{prof.stile}</p>}
          </li>
        ))}
      </ul>
    </>
  )}

  {body && (
    <>
      <h2>Note extra</h2>
      <SafeMarkdown text={body} />
    </>
  )}
</section>

<style>
  .modulo {
    margin-bottom: 32px;
    scroll-margin-top: 16px;
  }
  .modulo__nome {
    color: var(--caption);
    margin: 0 0 8px;
  }
  .docenti a {
    overflow-wrap: anywhere;
  }
  .docenti__stile {
    color: var(--text-2);
    margin: 4px 0 0;
  }
</style>
