---
import type { CollectionEntry } from 'astro:content';

type Contatti = CollectionEntry<'guide'>['data']['contatti'];

interface Props {
  contatti?: Contatti;
}

const { contatti } = Astro.props;
const hasContatti = contatti && (contatti.email || contatti.sito_web || contatti.ufficio);
---

{hasContatti && (
  <section class="contatti">
    <h2>Contatti</h2>
    <ul>
      {contatti?.email && (
        <li>Email: <a href={`mailto:${contatti.email}`}>{contatti.email}</a></li>
      )}
      {contatti?.sito_web && (
        <li>Sito web: <a href={contatti.sito_web} target="_blank" rel="noopener noreferrer">{contatti.sito_web}</a></li>
      )}
      {contatti?.ufficio && <li>Ufficio: {contatti.ufficio}</li>}
    </ul>
  </section>
)}

<style>
  .contatti {
    padding: 1.5rem 0;
    border-top: 1px solid #e2e8f0;
  }
  .contatti h2 {
    margin: 0 0 0.75rem;
  }
  .contatti ul {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>
