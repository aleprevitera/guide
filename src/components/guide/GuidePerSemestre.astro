---
// Guide di un anno divise per semestre (I, II, annuali), con in coda a ogni
// semestre gli esami ancora senza guida (schede bloccate). Se nulla indica
// il semestre, l'elenco resta unico, senza intestazioni.
import type { CollectionEntry } from 'astro:content';
import GuideList from './GuideList.astro';
import { ETICHETTA_SEMESTRE, semestreGuida, type Semestre } from '../../lib/guide';
import type { EsameInArrivo } from '../../lib/in-arrivo';

interface Props {
  entries: CollectionEntry<'guide'>[];
  inArrivo?: EsameInArrivo[];
  /** Livello dei titoli dei gruppi: h2 nella pagina dell'anno, h3 in /guide/. */
  livello?: 2 | 3;
}

const { entries, inArrivo = [], livello = 2 } = Astro.props;
const ordine: (Semestre | null)[] = ['I', 'II', 'Annuale', null];
const gruppi = ordine
  .map((semestre) => ({
    semestre,
    titolo: semestre ? ETICHETTA_SEMESTRE[semestre] : 'Semestre da definire',
    entries: entries.filter((e) => semestreGuida(e.data) === semestre),
    inArrivo: inArrivo.filter((e) => e.semestre === semestre),
  }))
  .filter((g) => g.entries.length + g.inArrivo.length > 0);
const senzaDivisione = gruppi.length === 1 && gruppi[0].semestre === null;
const Titolo = livello === 2 ? 'h2' : 'h3';
---

{senzaDivisione ? (
  <GuideList entries={entries} inArrivo={inArrivo} />
) : (
  gruppi.map((g) => (
    <section class="semestre">
      <Titolo class="semestre__titolo label">{g.titolo}</Titolo>
      <GuideList entries={g.entries} inArrivo={g.inArrivo} />
    </section>
  ))
)}

<style>
  .semestre + .semestre {
    margin-top: 24px;
  }
  .semestre__titolo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: var(--mondo-chiaro, var(--text-2));
  }
  /* Trattino a blocchi prima del titolo, come una tacca della mappa. */
  .semestre__titolo::before {
    content: '';
    width: 12px;
    height: 4px;
    background: currentColor;
  }
</style>
